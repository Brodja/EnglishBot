// Prisma Schema for English Learning Telegram Bot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  telegramId      BigInt    @id
  firstName       String?
  lastName        String?
  username        String?
  googleSheetsUrl String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  words           Word[]
  feedbacks       Feedback[]

  @@map("users")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    BigInt
  text      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("feedbacks")
}

model Word {
  id          String   @id @default(cuid())
  userId      BigInt
  english     String
  translation String

  passedEn       Boolean @default(false)
  passedUk       Boolean @default(false)
  learnedEn      Boolean @default(false)
  learnedUk      Boolean @default(false)
  reviewCountEn  Int     @default(0)
  reviewCountUk  Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@unique([userId, english])
  @@index([userId, learnedEn, passedEn])
  @@index([userId, learnedUk, passedUk])
  @@index([userId, learnedEn, reviewCountEn])
  @@index([userId, learnedUk, reviewCountUk])
  @@map("words")
}
