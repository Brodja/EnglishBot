// Prisma Schema for English Learning Telegram Bot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  telegramId      BigInt    @id
  firstName       String?
  lastName        String?
  username        String?
  googleSheetsUrl String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  words           Word[]

  @@map("users")
}

model Word {
  id          String   @id @default(cuid())
  userId      BigInt
  english     String
  translation String

  passedEn    Boolean  @default(false)
  passedUk    Boolean  @default(false)
  learned     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@unique([userId, english])
  @@index([userId, learned, passedEn])
  @@index([userId, learned, passedUk])
  @@map("words")
}
