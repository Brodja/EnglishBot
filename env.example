# Telegram Bot Token (отримайте у @BotFather)
API_KEY=your_telegram_bot_token_here

# PostgreSQL Connection URL
# Для локалки (docker compose у /docker):
DATABASE_URL=postgresql://englishbot:englishbot_pass@localhost:5432/englishbot

# Google Sheets API Key
# Без API Key працюють тільки публічні таблиці
# З API Key збільшуються ліміти запитів та надійність
# Отримати можна в Google Cloud Console
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# Telegram ID(s) адмінів через кому — їм бот пересилає feedback та показує адмін-меню
ADMIN_TELEGRAM_IDS=

# Середовище
NODE_ENV=development

# Порт
PORT=3000
